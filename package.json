{
  "name": "livechat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["server", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:operator": "npm run dev -w @livechat/operator",
    "dev:widget": "npm run dev -w @livechat/widget",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "db:migrate": "npm run db:migrate -w server"
  }
}
